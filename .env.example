# ==========================================
# Docker Configuration
# ==========================================
# User ID and Group ID mapping for file permissions on Linux
# Run `id -u` and `id -g` to find your values.
HOST_UID=1000
HOST_GID=1000

# Security configuration for gh cli
PARANOID_MODE=true

# ==========================================
# Multi-instance isolation
# ==========================================
# Each `make run` launches an agent instance (persistent `default` unless you set
# INSTANCE). The Makefile derives all
# of the variables below from INSTANCE and exports them into docker compose, so
# you normally do NOT set them here — this section documents the contract.
#
#   INSTANCE           name of the instance. Defaults to `default`, so a bare
#                      `make run` reuses .instances/default and persists state
#                      (sessions/model/auth) across runs. Set it for a
#                      concurrent, isolated instance:
#                        make run INSTANCE=my-feature
#   INSTANCE_ID        resolved instance id (INSTANCE, defaulting to `default`).
#   COMPOSE_PROJECT_NAME  pi-<INSTANCE_ID> — namespaces containers, the
#                      pi_network network and the pi_data/claude_data volumes so
#                      concurrent instances never collide.
#   PI_DATA_DIR        absolute host dir mounted at ~/.pi
#                      (default .instances/<INSTANCE_ID>/.pi-data)
#   CLAUDE_DATA_DIR    absolute host dir mounted at ~/.claude
#                      (default .instances/<INSTANCE_ID>/.claude-data)
#   WORKSPACE_DIR      absolute host dir mounted at /workspace
#                      (default ./workspace — the working copy is NOT per-instance)
#
# Isolated per instance: ~/.pi, ~/.claude and .claude.json (model/session/auth).
# Shared / user-controlled: the /workspace mount — set WORKSPACE_DIR to point it.
# Shared singletons: the credential-proxy and searxng sidecars and the
# read-only .secrets/github_token.txt secret.
# INSTANCE=
# WORKSPACE_DIR=

# GitHub token — two separate paths:
#   1. git operations (clone/push/pull) + the gh CLI read the token from
#      .secrets/github_token.txt via the setuid micro-vault. Required for git
#      auth; NOT set here.
#   2. The GitHub REST API is routed through the credential-proxy. To make that
#      path authenticated, uncomment GITHUB_TOKEN below and use the SAME token
#      as in .secrets/github_token.txt. Leave it unset and REST calls still work,
#      just anonymously (lower rate limits). The value is held by the proxy
#      container and never reaches the agent.
# Create a fine-grained PAT: https://github.com/settings/personal-access-tokens
# GITHUB_TOKEN=

# Git identity
GIT_NAME=Your Name
GIT_EMAIL=you@example.com

# Commit Signing (optional)
GIT_GPG_KEY=
GIT_GPG_SIGN=false

# ==========================================
# LLM API Keys
# ==========================================
# Keys are held by the credential-proxy sidecar and never forwarded to the
# agent container. The agent talks to the proxy at http://credential-proxy:8080
# and the proxy injects the real key before forwarding to the provider.
#
# Leave a line empty to skip that provider.
# Use `make providers` to verify which are active.
#
# OAuth/subscription users: leave ANTHROPIC_API_KEY empty and use
# `/login anthropic` inside pi — the proxy passes OAuth tokens through
# untouched.

# Anthropic — https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter (100+ models via one key) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Container resource caps (tune per machine) ---
# Maximum RAM the pi-agent container may use
MEM_LIMIT=4g
# Maximum CPU fraction (cores) the pi-agent container may use
CPUS=4.0

# --- SearXNG session key ---
# Unique per deployment — auto-generated by `make setup` if absent
# Regenerate manually: openssl rand -hex 32
SEARXNG_SECRET_KEY=
